<!DOCTYPE html>
<html>
<head>
    <title>Verifiable Credential Wallet</title>
</head>
<body>
    <h1>Verifiable Credential Wallet</h1>
    <button id="addCredentialButton">Add Credential</button>
    <div id="credentialList"></div>

    <script>
        const credentialList = document.getElementById('credentialList');
        const addCredentialButton = document.getElementById('addCredentialButton');

        addCredentialButton.addEventListener('click', () => {
            const credential = prompt('Enter your verifiable credential:');
            if (credential) {
                const credentialElement = document.createElement('p');
                credentialElement.textContent = credential;
                credentialList.appendChild(credentialElement);
            }
        });
    </script>
</body>
</html>
